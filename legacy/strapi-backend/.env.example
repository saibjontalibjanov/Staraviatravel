HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Comma-separated website origins allowed to submit directly to Strapi.
CLIENT_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Server-side flight provider key. Supply a real value securely in deployment settings.
SERPAPI_KEY=

# Telegram Bot API integration. Set real values securely on the Strapi server.
TELEGRAM_BOT_TOKEN=
# Numeric private/group chat ID for new lead notifications (groups often start with -100).
TELEGRAM_LEADS_CHAT_ID=
# Random 16–256 character secret using letters, digits, underscores and hyphens.
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS Strapi origin, used for the webhook and protected admin lead links.
PUBLIC_STRAPI_URL=

# Website origin used in private per-lead checkout links. HTTPS required in production.
PUBLIC_WEBSITE_URL=http://localhost:3000
