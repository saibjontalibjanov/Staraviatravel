# Copy selected values into the EXISTING server .env. Preserve all real secrets and DATABASE_URL.
DJANGO_SECRET_KEY=REPLACE_WITH_EXISTING_SERVER_SECRET
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.staraviatravel.com
DJANGO_HTTPS_ONLY=True
# Set True only if the Namecheap proxy demonstrably overwrites X-Forwarded-Proto.
TRUST_PROXY_HTTPS=False
TRUST_PROXY_CLIENT_IP=False
CRM_ROOT_ENABLED=True
PUBLIC_WEBSITE_URL=https://staraviatravel.com
PUBLIC_BACKEND_URL=https://api.staraviatravel.com
CLIENT_ORIGINS=https://staraviatravel.com,https://www.staraviatravel.com
CSRF_TRUSTED_ORIGINS=https://api.staraviatravel.com
# Keep existing production DATABASE_URL; unset/empty uses application data/db.sqlite3.
# Do not copy your local DB or its URL onto production.
# Keep existing SERPAPI_KEY, TELEGRAM_* and other secrets in the same backend .env.
