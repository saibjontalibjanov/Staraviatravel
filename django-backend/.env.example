# All backend secrets and API keys live in django-backend/.env only.
# Run python scripts/setup_env.py to create a local .env with a generated secret.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_HTTPS_ONLY=False
TRUST_PROXY_HTTPS=False
# Leave empty for data/db.sqlite3. Production example: postgresql://user:password@host:5432/staravia
DATABASE_URL=
PUBLIC_WEBSITE_URL=http://localhost:3000
PUBLIC_BACKEND_URL=
CLIENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Frontend build option (not a secret). Empty uses the same-origin /api proxy.
VITE_API_URL=

# Flight search: server-side SerpAPI Google Flights key.
SERPAPI_KEY=

# Telegram Bot API: keep these private; no personal Telegram account credentials.
TELEGRAM_BOT_TOKEN=
TELEGRAM_LEADS_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Reserved for a future verified CLICK payment implementation; NOT used to charge cards.
# The migrated application does not invent a working payment integration.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# Docker Compose PostgreSQL only. Use a URL-safe random password.
POSTGRES_DB=staravia
POSTGRES_USER=staravia
POSTGRES_PASSWORD=
# Enable only behind a trusted proxy that overwrites X-Real-IP.
TRUST_PROXY_CLIENT_IP=False
